# Copy to .env and adjust. Every setting is read as RAGENT_<NAME>; see src/ragent/config.py.

# Providers: ollama (default) or fake (offline, deterministic, for tests and CI)
RAGENT_LLM_PROVIDER=ollama
RAGENT_OLLAMA_URL=http://localhost:11434
RAGENT_CHAT_MODEL=llama3.1:8b
RAGENT_EMBED_MODEL=nomic-embed-text
RAGENT_EMBED_DIM=768

# Store: pgvector (default) or memory (no database, lost on exit)
RAGENT_STORE=pgvector
RAGENT_DATABASE_URL=postgresql://ragent:ragent@localhost:5432/ragent

# Chunking: structure | fixed
RAGENT_CHUNK_STRATEGY=structure
RAGENT_CHUNK_TOKENS=500
RAGENT_CHUNK_OVERLAP=60

# Retrieval: hybrid | vector | keyword ; reranker: none | lexical | llm
RAGENT_RETRIEVAL_MODE=hybrid
RAGENT_CANDIDATES=20
RAGENT_TOP_K=5
RAGENT_RERANKER=lexical

# Agent limits
RAGENT_MAX_STEPS=6
RAGENT_MAX_TOOL_CALLS=8
RAGENT_MIN_RELEVANCE=0.0

# Guardrails
RAGENT_INJECTION_SCAN=true
